{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://weisssa.github.io/portfolio/",
  "scripts": {
    "dev": "vite",
    "climate:snapshot": "node scripts/fetch-climate-snapshot.mjs",
    "prebuild": "npm run climate:snapshot",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/css-hex-guard.mjs",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src scripts tests index.html playwright.config.ts public/404.html vite.config.ts package.json",
    "format:fix": "prettier --write --no-error-on-unmatched-pattern src scripts tests index.html playwright.config.ts public/404.html vite.config.ts package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit && node scripts/check-3d-budget.mjs",
    "capture:qa": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run size"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.65.1",
    "@react-three/test-renderer": "^9.1.1",
    "@size-limit/file": "^11.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "size-limit": "^11.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/*.css",
        "dist/assets/*.woff2"
      ],
      "limit": "120 KB"
    }
  ]
}
